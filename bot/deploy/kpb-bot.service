[Unit]
Description=KPB Discord listener bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kpb
WorkingDirectory=/opt/kpb-bot
EnvironmentFile=/opt/kpb-bot/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
